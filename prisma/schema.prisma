// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//*************************************************************
// --------------- GERENCIAMENTO DE USUÁRIOS-------------------
//*************************************************************
model Imob {
  id                     String                  @id @default(uuid())
  orgId                  String                  @unique
  razaoSocial            String?
  nomeFantasia           String?
  cnpj                   String?
  telefone               String?
  emailContato           String?
  logoUrl                String?
  creci                  String?
  representanteNome      String?
  cep                    String?
  logradouro             String?
  numero                 String?
  complemento            String?
  bairro                 String?
  cidade                 String?
  uf                     String?
  users                  Users[]
  imovels                Imovel[]
  contratoImovelLocacaos ContratoImovelLocacao[]
  configuracaoInter      ConfiguracaoInter?
  prestadorServicos      PrestadorServico[]
  manutencoes            Manutencao[]
  persons                Person[]
  leases                 Lease[]
  residenciais           Residencial[]

  @@map("imob")
}

model Users {
  id        String    @id // vai ser o mesmo do clerk
  email     String
  firstName String
  lastName  String
  creci     String?
  role      UsersRole
  ativo     Boolean   @default(true)

  imobId               String
  imob                 Imob                  @relation(fields: [imobId], references: [id], onDelete: Cascade)
  operadorVistorias    Vistoria[]            @relation(name: "VistoriaOperador")
  vistoriadorVistorias Vistoria[]            @relation(name: "VistoriaVistoriador")
  transacoes           TransacaoFinanceira[]
  comissoes            Comissao[]

  @@map("users")
}

enum UsersRole {
  OPERADOR
  CORRETOR
  ADMIN
}

//*************************************************************
// --------------- GERENCIAMENTO DE IMÓVEIS--------------------
//*************************************************************

model Imovel {
  id              String     @id @default(uuid())
  codigo          String     @unique
  numero          Int
  complemento     String?
  logradouro      String?
  bairro          String
  cidade          String
  uf              String
  cep             Int
  latitude        Float?
  longitude       Float?
  tipo            TipoImovel @default(CASA)
  forVenda        Boolean    @default(false)
  forLocacao      Boolean    @default(false)
  valorAluguel    Int?
  valorCondominio Int?
  valorIPTU       Int?
  valorVenda      Int?
  valorTotal      Int?
  area            Int        @default(0)

  titulo    String   @default("")
  descricao String?  @db.Text
  imagens   String[] @default([])
  videos    String[] @default([])
  quartos   Int?     @default(0)
  banheiros Int?     @default(0)
  vagas     Int?     @default(0)
  publicado Boolean  @default(false)
  highlight Boolean  @default(false)
  alugado   Boolean  @default(false)
  vendido   Boolean  @default(false)

  loteamentoId String?
  loteamento   Loteamento? @relation(fields: [loteamentoId], references: [id], onDelete: Cascade)
  quadra       String?
  loteNumero   String?
  topografia   String?
  statusLote   StatusLote? @default(DISPONIVEL)

  aluguelDados Json?

  imobId                 String
  imob                   Imob                    @relation(fields: [imobId], references: [id], onDelete: Cascade)
  imovelLocacaos         ImovelLocacao[]
  imovelVendas           ImovelVenda[]
  vistorias              Vistoria[]
  contratoImovelLocacaos ContratoImovelLocacao[]
  transacoes             TransacaoFinanceira[]
  manutencoes            Manutencao[]
  leases                 Lease[]
  residencialId          String?
  residencial            Residencial?            @relation(fields: [residencialId], references: [id], onDelete: SetNull)
  manutencoesResidencial ResidencialManutencao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([residencialId])
  @@map("imovel")
}

enum TipoResidencial {
  RESIDENCIAL
  CONDOMINIO
}

enum CategoriaDespesaResidencial {
  INTERNET
  GAS
  LIMPEZA
  SEGURANCA
  JARDINAGEM
  ENERGIA_COMUM
  OUTROS
}

enum EscopoManutencaoResidencial {
  GERAL
  IMOVEL_ESPECIFICO
}

enum TipoRateioResidencial {
  IGUALITARIO
  VALOR_FIXO
  PERCENTUAL
  NAO_RATEAR
}

model Residencial {
  id          String                  @id @default(cuid())
  imobId      String
  imob        Imob                    @relation(fields: [imobId], references: [id], onDelete: Cascade)
  nome        String
  tipo        TipoResidencial         @default(RESIDENCIAL)
  descricao   String?                 @db.Text
  ativo       Boolean                 @default(true)
  imoveis     Imovel[]
  despesas    ResidencialDespesa[]
  manutencoes ResidencialManutencao[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([imobId, nome])
  @@index([imobId, ativo])
  @@map("residencial")
}

model ResidencialDespesa {
  id             String                      @id @default(cuid())
  residencialId  String
  residencial    Residencial                 @relation(fields: [residencialId], references: [id], onDelete: Cascade)
  nome           String
  categoria      CategoriaDespesaResidencial
  valor          Decimal                     @db.Decimal(15, 2)
  inicioVigencia DateTime
  fimVigencia    DateTime?
  ativo          Boolean                     @default(true)
  observacao     String?                     @db.Text
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([residencialId, ativo, inicioVigencia, fimVigencia])
  @@map("residencial_despesa")
}

model ResidencialManutencao {
  id             String                      @id @default(cuid())
  residencialId  String
  residencial    Residencial                 @relation(fields: [residencialId], references: [id], onDelete: Cascade)
  imovelId       String?
  imovel         Imovel?                     @relation(fields: [imovelId], references: [id], onDelete: SetNull)
  descricao      String                      @db.Text
  dataManutencao DateTime
  valor          Decimal                     @db.Decimal(15, 2)
  status         StatusManutencao            @default(EM_ANDAMENTO)
  escopo         EscopoManutencaoResidencial @default(GERAL)
  tipoRateio     TipoRateioResidencial       @default(NAO_RATEAR)
  rateio         Json?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([residencialId, dataManutencao])
  @@index([imovelId])
  @@map("residencial_manutencao")
}

//*************************************************************
model ImovelLocacao {
  id            String   @id @default(uuid())
  dataInicio    DateTime
  valorAluguel  Float?
  dataFim       DateTime
  hasCondominio Boolean
  hasIPTU       Boolean
  valorTotal    Float

  taxaAdministracao       Float? // Taxa de administração (ex: 10.00)
  taxaMultasEncargos      Float? // Taxa sobre multas e encargos (ex: 50.00)
  taxaIntermediacao       Float? // Taxa de intermediação (ex: 100.00)
  irrfResponsabilidade    String? // "LOCADOR" ou "LOCATARIO"
  carenciaRepasse         Int? // Carência para repasse do aluguel (ex: 10)
  honorariosAdvPercentual Float?
  carenciaHonorariosDias  Int?
  periodoGarantido        String?
  abrangenciaGarantia     String?
  diaVencimento           Int?
  vencimentoOrigem        String  @default("NAO_DEFINIDO")

  // Relação com múltiplos períodos vigentes e históricos
  periodos PeriodoContratoLocacao[]

  // --- REAJUSTE ---
  proximoReajuste       DateTime?
  periodicidadeReajuste Int? // Salva em meses. Ex: 12
  indiceReajuste        String? // Ex: "IGP-M", "IPCA", "INPC"

  // --- QUALIDADE DO HISTORICO LOCATICIO ---
  historicoPeriodosStatus String    @default("NAO_INICIADO") // NAO_INICIADO, PARCIAL, COMPLETO, DIVERGENTE
  historicoRevisadoEm     DateTime?

  // --- QUEBRA DE CONTRATO ---
  multaQuebraContrato     Float? // Valor ou percentual (ex: 8.33)
  tipoMultaQuebra         String? // "PERCENTUAL", "MESES" ou "VALOR"
  multaQuebraPercentual   Float?
  multaQuebraProporcional Boolean   @default(true)
  vencimentoQuebra        DateTime? // "Quebra do contrato vence em"

  // --- PONTUALIDADE (Mantido opcional na tabela pai) ---
  descontoPontualidade Float? // Ex: 5.11
  tipoDesconto         String? // "PERCENTUAL" ou "VALOR"
  diasAntecedenciaDesc Int? // "Até quantos dias antes" (Ex: 12)

  // --- MULTA E JUROS (Mantido opcional na tabela pai) ---
  multaAtrasoPercentual  Float? // Ex: 2.00
  diasCarenciaMulta      Int? // "Cobrar após X dias" (Ex: 1)
  jurosAtrasoPercentual  Float? // Juros mensal pro rata (Ex: 1.00)
  diasCarenciaJuros      Int? // "Cobrar após X dias" (Ex: 1)
  imovelId               String
  imovel                 Imovel                  @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  locadors               Locador[]
  contratoImovelLocacaos ContratoImovelLocacao[]
  parcelasIntermediacao  ParcelaIntermediacao[]
  person                 Person?                 @relation(fields: [personId], references: [id])
  personId               String?

  @@map("imovel_locacao")
}

model PeriodoContratoLocacao {
  id              String        @id @default(uuid())
  imovelLocacaoId String
  imovelLocacao   ImovelLocacao @relation(fields: [imovelLocacaoId], references: [id], onDelete: Cascade)

  dataInicio DateTime
  dataFim    DateTime // Fim do período (ex: De 27/08/2024 a 26/08/2025)

  valorAluguel    Float
  hasCondominio   Boolean @default(false)
  valorCondominio Float?
  hasIPTU         Boolean @default(false)
  valorIPTU       Float?
  valorTotal      Float

  descontoPontualidade Float?
  tipoDesconto         String? // "PERCENTUAL" ou "VALOR"
  diasAntecedenciaDesc Int?

  multaAtrasoPercentual    Float?
  diasCarenciaMulta        Int?
  jurosAtrasoPercentual    Float?
  diasCarenciaJuros        Int?
  indiceReajuste           String?
  valorAluguelAnterior     Float?
  percentualReajuste       Float?
  reajusteAutomatico       Boolean   @default(false)
  manterValorDeflacao      Boolean   @default(true)
  dataCalculoReajuste      DateTime?
  reajusteExecutadoPorId   String?
  reajusteExecutadoPorNome String?
  tipoPeriodo              String    @default("REAJUSTE") // BASE ou REAJUSTE
  origemPeriodo            String    @default("MANUAL") // MANUAL, SICADI_PROVISORIO ou CALCULO_SISTEMA
  diaVencimento            Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dataFim])
  @@index([imovelLocacaoId, dataInicio, dataFim])
  @@map("periodo_contrato_locacao")
}

model IndiceEconomicoValor {
  id           String   @id @default(cuid())
  codigo       String
  competencia  DateTime
  taxaMensal   Decimal  @db.Decimal(12, 8)
  fonte        String   @default("BCB_SGS")
  consultadoEm DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([codigo, competencia])
  @@index([competencia])
  @@map("indice_economico_valor")
}

model ParcelaIntermediacao {
  id              String        @id @default(uuid())
  imovelLocacaoId String
  imovelLocacao   ImovelLocacao @relation(fields: [imovelLocacaoId], references: [id], onDelete: Cascade)
  ordem           Int
  dataVencimento  DateTime
  valor           Float
  observacao      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([imovelLocacaoId, ordem])
  @@index([imovelLocacaoId, dataVencimento])
  @@map("parcela_intermediacao")
}

// pessoa
model Locador {
  id            String @id @default(uuid())
  nome          String
  cpfCnpj       String
  telefone      Json? // {objeto com telefone, qualificacao e observacao}
  email         String
  endereco      Json? // {objeto com cep, logradouro, numero, complemento, bairro, municipio, estado.}
  dataNasc      String
  rg            String
  orgaoEmissor  String
  estadoCivil   String
  profissao     String
  nacionalidade String
  genero        String

  documentoUrl    Json? // objeto com lista de urls (documentos feitos uploads com url e nome do documentos)
  imovelLocacaoId String?
  imovelLocacao   ImovelLocacao? @relation(fields: [imovelLocacaoId], references: [id], onDelete: Cascade)
}

enum PersonCategory {
  FISICA
  JURIDICA
}

model Person {
  id             String         @id @default(cuid())
  imobId         String
  imob           Imob           @relation(fields: [imobId], references: [id], onDelete: Cascade)
  type           PersonType
  category       PersonCategory @default(FISICA)
  name           String
  cpfCnpj        String
  secondaryEmail String?
  email          String?

  // --- Pessoa Física ---
  rg            String?
  issuingAgency String?
  birthDate     DateTime?
  nationality   String?
  profession    String?
  maritalStatus String?
  gender        String?
  monthlyIncome Decimal?
  rne           String?

  // --- Pessoa Jurídica ---
  stateRegistration     String?
  municipalRegistration String?
  activity              String?
  icmsTaxpayerType      String?
  optantSimples         Boolean?

  // --- Responsável Legal (PJ) ---
  legalRepName              String?
  legalRepCpf               String?
  legalRepRg                String?
  legalRepIssuingAgency     String?
  legalRepEmail             String?
  legalRepPhoneMobile       String?
  legalRepPhoneMobileDesc   String?
  legalRepPhoneLandline     String?
  legalRepPhoneLandlineDesc String?

  // --- Contato Financeiro (PJ) ---
  financialName              String?
  financialEmail             String?
  financialPhoneMobile       String?
  financialPhoneMobileDesc   String?
  financialPhoneLandline     String?
  financialPhoneLandlineDesc String?

  // --- Dados bancários do proprietário ---
  bankName    String?
  bankAgency  String?
  bankAccount String?
  pixKey      String?

  createdAt    DateTime        @default(now())
  phones       PersonPhone[]
  addresses    PersonAddress[]
  contratos    ImovelLocacao[]
  leaseParties LeaseParty[]

  @@map("person")
}

enum PersonType {
  LOCADOR
  LOCATARIO
  FIADOR
}

model PersonPhone {
  id          String  @id @default(cuid())
  personId    String
  person      Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  phone       String
  type        String
  observation String?

  @@map("person_phone")
}

model PersonAddress {
  id          String  @id @default(cuid())
  personId    String
  person      Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  municipio   String
  estado      String

  @@map("person_address")
}

enum LeaseStatus {
  DRAFT
  REVIEW_PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
  CANCELLED
}

enum RentalType {
  RESIDENTIAL
  COMMERCIAL
  SEASONAL
}

model Lease {
  id               String      @id @default(cuid())
  tenantId         String
  imob             Imob        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String      @unique
  status           LeaseStatus @default(DRAFT)
  purpose          String?
  rentalType       RentalType?
  propertyId       String?
  property         Imovel?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  startDate        DateTime?
  endDate          DateTime?
  legacySystem     String?
  legacyCode       String?
  migratedAt       DateTime?
  reviewedAt       DateTime?
  billingStartDate DateTime?
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  parties      LeaseParty[]
  terms        LeaseTerms?
  termsPeriods LeaseTermsPeriod[]
  charges      LeaseCharge[]
  transacoes   TransacaoFinanceira[]
  guarantee    LeaseGuarantee?
  clauses      LeaseClause[]
  documents    LeaseDocument[]
  iptu         LeaseIptu?
  utilities    LeaseUtility[]
  condominium  LeaseCondominium?

  @@unique([tenantId, legacySystem, legacyCode])
  @@index([tenantId, status])
  @@index([tenantId, billingStartDate])
  @@map("lease")
}

model LeaseIptu {
  id               String    @id @default(cuid())
  leaseId          String    @unique
  lease            Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  inscription      String?
  sequentialNumber String?
  bookletHolder    String?
  responsibleParty String?
  lastCheckedDate  DateTime?
  documentUrl      String?
  amount           Decimal?  @db.Decimal(15, 2)
  paymentStartDate DateTime?
  installments     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lease_iptu")
}

model LeaseUtility {
  id              String    @id @default(cuid())
  leaseId         String
  lease           Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type            String
  amount          Decimal?  @db.Decimal(15, 2)
  identification  String?
  lastCheckedDate DateTime?
  observation     String?   @db.Text
  documentUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, type])
  @@map("lease_utility")
}

model LeaseCondominium {
  id               String    @id @default(cuid())
  leaseId          String    @unique
  lease            Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amount           Decimal?  @db.Decimal(15, 2)
  condoName        String?
  adminName        String?
  adminPhone       String?
  adminEmail       String?
  adminWebsite     String?
  syndicName       String?
  syndicPhone      String?
  responsibleParty String?
  lastCheckedDate  DateTime?
  documentUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lease_condominium")
}

model LeaseParty {
  id            String         @id @default(cuid())
  leaseId       String
  personId      String
  role          LeasePartyRole
  jointlyLiable Boolean        @default(false)
  isPrimary     Boolean        @default(false)
  participation Decimal?

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, personId, role])
  @@index([leaseId])
  @@index([personId])
  @@map("lease_party")
}

enum LeasePartyRole {
  TENANT
  CO_TENANT
  LANDLORD
  GUARANTOR
  SPOUSE
  LEGAL_REPRESENTATIVE
}

model LeaseTerms {
  id      String @id @default(cuid())
  leaseId String @unique
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  // --- Dados do contrato ---
  contractMonths       Int?      @default(30)
  contractPenaltyValue Decimal?  @db.Decimal(15, 2)
  contractPenaltyType  String?   @default("PERCENT")
  penaltyBeforeDate    DateTime?
  readjustmentPeriodM  Int?      @default(12)
  readjustmentIndex    String?   @default("IGP-M")

  // --- Aluguel & Vencimentos ---
  rentValue            Decimal   @db.Decimal(15, 2)
  paymentDueDay        Int       @default(10)
  firstPeriodStartDate DateTime?
  firstPeriodEndDay    String?
  firstPeriodDueDate   DateTime?
  nextReadjustmentDate DateTime?

  // --- Pontualidade ---
  earlyPaymentDiscount Decimal? @db.Decimal(15, 2)
  discountType         String?  @default("PERCENT")
  discountDaysBefore   Int?     @default(1)

  // --- Multa e outros encargos ---
  lateFeePercentage   Decimal? @db.Decimal(5, 2)
  lateFeeDays         Int?     @default(1)
  lateInterestMonthly Decimal? @db.Decimal(5, 2)
  lateInterestDays    Int?     @default(1)
  lawyerFeePercentage Decimal? @db.Decimal(5, 2)
  lawyerFeeGraceDays  Int?     @default(90)

  // --- Repasse ---
  transferGraceDays Int?    @default(10)
  guaranteedPeriod  String? @default("Não garantir")
  guaranteeScope    String? @default("Somente o aluguel")

  // --- Administração ---
  adminFeePercentage      Decimal? @db.Decimal(5, 2)
  adminFeeFinesPercentage Decimal? @db.Decimal(5, 2)
  brokerageFeePercentage  Decimal? @db.Decimal(5, 2)

  // --- Retenção IRRF ---
  irrfRetentionResponsibility String? @default("LOCATARIO")

  // --- Forma de cobrança ---
  billingMethod String? @default("NONE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lease_terms")
}

model LeaseTermsPeriod {
  id      String @id @default(cuid())
  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  rentAmount    Decimal @db.Decimal(15, 2)
  paymentDueDay Int

  adjustmentIndex      String?
  adjustmentPercentage Decimal? @db.Decimal(8, 4)
  previousRentAmount   Decimal? @db.Decimal(15, 2)

  earlyPaymentDiscount Decimal? @db.Decimal(15, 2)
  discountType         String?
  discountDaysBefore   Int?

  lateFeePercentage   Decimal? @db.Decimal(5, 2)
  lateFeeDays         Int?
  lateInterestMonthly Decimal? @db.Decimal(5, 2)
  lateInterestDays    Int?

  lawyerFeePercentage Decimal? @db.Decimal(5, 2)
  lawyerFeeGraceDays  Int?

  transferGraceDays Int?
  guaranteedPeriod  String?
  guaranteeScope    String?

  adminFeePercentage      Decimal? @db.Decimal(5, 2)
  adminFeeFinesPercentage Decimal? @db.Decimal(5, 2)
  brokerageFeePercentage  Decimal? @db.Decimal(5, 2)

  source       String  @default("MANUAL")
  externalId   String?
  reviewStatus String  @default("PENDING")
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges LeaseCharge[]

  @@index([leaseId, effectiveFrom, effectiveTo])
  @@index([leaseId, createdAt])
  @@map("lease_terms_period")
}

model LeaseCharge {
  id              String            @id @default(cuid())
  leaseId         String
  lease           Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  termsPeriodId   String?
  termsPeriod     LeaseTermsPeriod? @relation(fields: [termsPeriodId], references: [id], onDelete: SetNull)
  competence      String?
  description     String
  chargeType      String
  amount          Decimal           @db.Decimal(15, 2)
  calculationData Json?
  dueDate         DateTime
  paidDate        DateTime?
  status          String            @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, competence, chargeType])
  @@index([termsPeriodId])
  @@map("lease_charge")
}

model LeaseGuarantee {
  id        String   @id @default(cuid())
  leaseId   String   @unique
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type      String
  details   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lease_guarantee")
}

model LeaseClause {
  id        String   @id @default(cuid())
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lease_clause")
}

model LeaseDocument {
  id        String   @id @default(cuid())
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String?
  createdAt DateTime @default(now())

  @@map("lease_document")
}

model ContratoImovelLocacao {
  id              String  @id @default(uuid())
  imovelLocacaoId String?

  imovelLocacao ImovelLocacao? @relation(fields: [imovelLocacaoId], references: [id], onDelete: Cascade)
  imovelId      String
  imovel        Imovel         @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  imobId               String
  imob                 Imob                  @relation(fields: [imobId], references: [id], onDelete: Cascade)
  fiadors              Fiador[]
  locatarios           Locatario[]
  transacaoFinanceiras TransacaoFinanceira[]
  documentoUrl         Json?
  manutencoes          Manutencao[]

  @@map("contrato_imovel_locacao")
}

model Fiador {
  id            String @id @default(uuid())
  nome          String
  cpfCnpj       String
  telefone      Json? // {objeto com telefone, qualificacao e observacao}
  email         String
  endereco      Json? // {objeto com cep, logradouro, numero, complemento, bairro, municipio, estado.}
  dataNasc      String
  rg            String
  orgaoEmissor  String
  estadoCivil   String
  profissao     String
  nacionalidade String
  genero        String

  documentoUrl Json? // objeto com lista de urls (documentos feitos uploads com url e nome do documentos)
  contratoId   String
  contrato     ContratoImovelLocacao @relation(fields: [contratoId], references: [id], onDelete: Cascade)
}

model Locatario {
  id            String  @id @default(uuid())
  nome          String
  cpfCnpj       String
  telefone      Json? // [{ tipo: string, numero: string, observacao?: string }]
  email         String
  endereco      Json? // { cep, logradouro, numero, complemento, bairro, municipio, estado }
  dataNasc      String
  rg            String
  orgaoEmissor  String
  estadoCivil   String
  profissao     String
  nacionalidade String
  genero        String
  rendaMensal   Float?
  rne           String?

  // Dados do Cônjuge
  conjugeNome          String?
  conjugeCpf           String?
  conjugeRg            String?
  conjugeOrgaoEmissor  String?
  conjugeEmail         String?
  conjugeDataNasc      String?
  conjugeProfissao     String?
  conjugeRendaMensal   Float?
  conjugeNacionalidade String?
  conjugeRne           String?
  conjugeTelefone      Json? // [{ tipo: string, numero: string, observacao?: string }]

  documentoUrl    Json? // Objeto/lista JSON mapeando documentos digitalizados por categoria/nome
  contratoId      String?
  contrato        ContratoImovelLocacao? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  vistorias       Vistoria[]
  acessosVistoria VistoriaLocatario[]
}

//*************************************************************
// --------------- VENDAS --------------------
//*************************************************************

model ImovelVenda {
  id         String   @id @default(uuid())
  dataInicio DateTime
  dataFim    DateTime

  imovelId String
  imovel   Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_venda")
}

model Loteamento {
  id              String   @id @default(uuid())
  nome            String
  slug            String   @unique
  cidade          String
  uf              String
  descricao       String   @db.Text
  imagens         Json?
  infraestrutura  Json?
  coordenadasSvg  Json?
  dadosCondominio Json?
  lotes           Imovel[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("loteamento")
}

enum StatusLote {
  DISPONIVEL
  RESERVADO
  VENDIDO
}

model Lead {
  id            String     @id @default(uuid())
  nome          String
  telefone      String
  email         String?
  loteInfo      String? // Ex: "Quadra A - Lote 03 (253m²)"
  valorSimulado Float?
  status        LeadStatus @default(NOVO)
  origem        String     @default("SITE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Preferências de Interesse para Match de Imóveis
  interesseTipo      TipoImovel?
  interesseNegocio   String? // 'VENDA', 'LOCACAO' ou 'AMBOS'
  interessePrecoMin  Float?
  interessePrecoMax  Float?
  interesseQuartos   Int?
  interesseBanheiros Int?
  interesseVagas     Int?
  interesseBairros   String?

  // Automação de E-mail
  envioAutomatico Boolean   @default(false)
  ultimoEnvioAuto DateTime?

  @@map("lead")
}

enum LeadStatus {
  NOVO
  EM_ATENDIMENTO
  VISITA_AGENDADA
  FECHADO
  PERDIDO
}

//*************************************************************
// --------------- VISTORIA --------------------
//*************************************************************

model Vistoria {
  id          String       @id @default(uuid())
  codigo      String
  data        DateTime
  tipo        TipoVistoria
  observacoes String       @db.Text // Aba "OBSERVAÇÕES" (já existente)
  assinatura  String? // Aba "INFORMAÇÕES"

  operadorId String
  operador   Users  @relation(name: "VistoriaOperador", fields: [operadorId], references: [id])

  vistoriadorId String
  vistoriador   Users  @relation(name: "VistoriaVistoriador", fields: [vistoriadorId], references: [id])

  imovelId String
  imovel   Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  tipoImovelVistoriado TipoImovelVistoriado
  status               VistoriaStatus
  ambienteVistorias    AmbienteVistoria[]
  comentariosVistoria  ComentarioVistoria[]

  // ==========================================
  // METADADOS DO PROPRIETÁRIO
  // ==========================================
  proprietario     String?
  // Snapshot historico: alteracoes posteriores no cadastro do imovel nao mudam esta vistoria.
  enderecoSnapshot Json?

  // ==========================================
  // ABA: TERMOS GERAIS (JSON)
  // ==========================================
  infoGeral Json?

  // ==========================================
  // ABA: CHAVES (Simplificado)
  // ==========================================
  chavesQuantidade Int?
  chavesObservacao String? @db.Text // Descrição ex: "3 chaves da porta, 1 do portão"

  // ==========================================
  // ABA: MEDIDORES (Água e Luz)
  // ==========================================
  medidorAguaNumero  String? // Número do relógio da água
  medidorAguaLeitura String? // Leitura atual (consumo)
  medidorAguaFotoUrl String? // Foto do medidor de água

  medidorLuzNumero  String? // Número do relógio da luz
  medidorLuzLeitura String? // Leitura atual (consumo)
  medidorLuzFotoUrl String? // Foto do medidor de luz

  // ==========================================
  // ABA: REPAROS (Simplificado)
  // ==========================================
  reparosNecessarios String? @db.Text // Anotação livre sobre o que precisa arrumar

  // ==========================================
  // ABA: LIMPEZA
  // ==========================================
  limpezaStatus     LimpezaStatus?
  limpezaObservacao String?        @db.Text // Detalhes da limpeza

  // ==========================================
  // ABA: GEOLOCALIZAÇÃO (Para auditoria de presença do vistoriador)
  // ==========================================
  latitude              Float?
  longitude             Float?
  fotoItems             FotoItem[]
  contestacaoVistorias  ContestacaoVistoria[]
  tokenAcesso           String?               @unique
  locatarioId           String?
  locatario             Locatario?            @relation(fields: [locatarioId], references: [id], onDelete: SetNull)
  locatariosAutorizados VistoriaLocatario[]

  @@map("vistoria")
}

model VistoriaLocatario {
  vistoriaId  String
  locatarioId String
  vistoria    Vistoria  @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
  locatario   Locatario @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([vistoriaId, locatarioId])
  @@index([locatarioId])
  @@map("vistoria_locatario")
}

model ContestacaoVistoria {
  id                  String    @id @default(uuid())
  vistoriaId          String
  vistoria            Vistoria  @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
  ambienteId          String? // Opcional: Se for contestação de um cômodo específico
  ambienteNome        String?
  descricao           String    @db.Text
  midias              Json? // Fotos anexadas pelo inquilino
  createdAt           DateTime  @default(now())
  resolvido           Boolean   @default(false)
  respostaAdmin       String?   @db.Text
  profissionalNome    String?
  profissionalContato String?
  comprovanteUrl      String?
  resolvidoEm         DateTime?
}

// Enum simples para a aba Limpeza
enum LimpezaStatus {
  EXCELENTE
  BOA
  REGULAR
  RUIM
}

enum TipoImovelVistoriado {
  CASA
  APARTAMENTO
}

enum TipoImovel {
  CASA
  CONDOMINIO
  LOTE
  COMERCIAL
  RURAL
  KITNET
}

enum TipoVistoria {
  ENTRADA
  SAIDA
  PERIODICA
}

enum VistoriaStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  AGUARDANDO_APROVACAO
  CONCLUIDA
  CONTESTADA
  CANCELADA
}

model AmbienteVistoria {
  id          String  @id @default(uuid())
  nome        String // Ex: "Fachada", "Quintal", "Sala"
  tipo        String  @default("Outro") // Quarto, Sala, Cozinha, etc.
  ordem       Int     @default(0) // Permite ordenar a lista lateral
  visaoGeral  String? @db.Text
  comentarios String? @db.Text

  vistoriaId String
  vistoria   Vistoria       @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
  itens      ItemAmbiente[]

  @@map("ambiente_vistoria")
}

// 3. Os Subitens/Componentes de cada Ambiente (Visão Geral, Paredes, Piso, etc.)
model ItemAmbiente {
  id                 String           @id @default(uuid())
  nome               String // Ex: "Visão Geral"
  ordem              Int              @default(0)
  statusVerificacao  ItemStatus       @default(PENDENTE) // Controla o check verde e o X vermelho
  ambienteVistoriaId String
  ambienteVistoria   AmbienteVistoria @relation(fields: [ambienteVistoriaId], references: [id], onDelete: Cascade)
  comentarios        ComentarioItem[]
  fotos              FotoItem[]

  @@map("item_ambiente")
}

// Enum para o status do item (Conforme / Não Conforme)
enum ItemStatus {
  PENDENTE
  CONFORME // Botão verde (check)
  NAO_CONFORME // Botão vermelho (X)
}

// 4. Comentários específicos por Item do Ambiente
model ComentarioItem {
  id             String            @id @default(uuid())
  texto          String            @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  itemAmbienteId String
  itemAmbiente   ItemAmbiente      @relation(fields: [itemAmbienteId], references: [id], onDelete: Cascade)
  midias         MidiaComentario[]

  @@map("comentario_item")
}

model ComentarioVistoria {
  id         String   @id @default(uuid())
  vistoriaId String
  vistoria   Vistoria @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
  roomId     String // "geral" ou o ID do AmbienteVistoria
  roomName   String
  texto      String   @db.Text
  status     String // "Aprovado" ou "Atenção"
  createdAt  DateTime @default(now())
  midias     Json? // Lista de { url, tipo }

  @@map("comentario_vistoria")
}

// 5. Fotos específicas por Item do Ambiente
model FotoItem {
  id        String   @id @default(uuid())
  url       String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  // Relaciona a foto a um item de ambiente (comportamento atual)
  itemAmbienteId String?
  itemAmbiente   ItemAmbiente? @relation(fields: [itemAmbienteId], references: [id], onDelete: Cascade)
  // Opcional: Relaciona a foto diretamente à Vistoria (para Medidores/Chaves)
  vistoriaId     String?
  vistoria       Vistoria?     @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)

  @@map("foto_item")
}

model MidiaComentario {
  id           String         @id @default(uuid())
  url          String
  tipo         TipoMidia      @default(FOTO)
  ordem        Int            @default(0)
  createdAt    DateTime       @default(now())
  comentarioId String
  comentario   ComentarioItem @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@map("midia_comentario")
}

enum TipoMidia {
  FOTO
  VIDEO
}

model ContractTemplate {
  id        String   @id @default(uuid())
  name      String
  type      String // 'LOCACAO' | 'VENDA' | 'LIMPEZA' | 'PROPOSTA'
  fileName  String // Nome do arquivo gerado em public/templates-docx/[uuid].docx
  content   String   @db.Text // Texto simples extraído do docx para pré-visualização
  variables String[] @default([]) // Array de variáveis detectadas ex: ["nome_inquilino", "cpf"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_template")
}

//*************************************************************
// --------------- MANUTENCOES --------------------
//*************************************************************

model PrestadorServico {
  id        String   @id @default(uuid())
  imobId    String
  nome      String
  area      String
  telefone  String?
  pix       String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imob        Imob         @relation(fields: [imobId], references: [id], onDelete: Cascade)
  manutencoes Manutencao[]

  @@index([imobId, nome])
  @@map("prestador_servico")
}

enum StatusManutencao {
  EM_ANDAMENTO
  FINALIZADA
}

enum StatusDescontoManutencao {
  PROGRAMADO
  APLICADO
  CANCELADO
}

model Manutencao {
  id                   String           @id @default(uuid())
  imobId               String
  contratoId           String
  imovelId             String
  prestadorId          String?
  descricao            String           @db.Text
  dataManutencao       DateTime
  valor                Decimal          @db.Decimal(15, 2)
  status               StatusManutencao @default(EM_ANDAMENTO)
  repassarProprietario Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  imob       Imob                  @relation(fields: [imobId], references: [id], onDelete: Cascade)
  imovel     Imovel                @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  contrato   ContratoImovelLocacao @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  prestador  PrestadorServico?     @relation(fields: [prestadorId], references: [id], onDelete: SetNull)
  documentos DocumentoManutencao[]
  descontos  DescontoManutencao[]

  @@index([imobId])
  @@index([contratoId])
  @@index([imovelId])
  @@index([prestadorId])
  @@map("manutencao")
}

model DocumentoManutencao {
  id           String   @id @default(uuid())
  manutencaoId String
  nomeOriginal String
  url          String
  storageKey   String?
  mimeType     String
  tamanhoBytes Int?
  createdAt    DateTime @default(now())

  manutencao Manutencao @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
}

model DescontoManutencao {
  id           String                   @id @default(uuid())
  manutencaoId String
  competencia  String // Formato YYYY-MM
  valor        Decimal                  @db.Decimal(15, 2)
  status       StatusDescontoManutencao @default(PROGRAMADO)
  repasseId    String?
  aplicadoEm   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  manutencao Manutencao           @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  repasse    TransacaoFinanceira? @relation(fields: [repasseId], references: [id], onDelete: SetNull)

  @@unique([manutencaoId, competencia])
  @@index([competencia, status])
}

//*************************************************************
// --------------- FINANCEIRO --------------------
//*************************************************************

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum CategoriaTransacao {
  ALUGUEL
  REPASSE
  TAXA_ADM
  COMISSAO
  CUSTO_OPERACIONAL
  OUTRO
}

enum StatusTransacao {
  PENDENTE
  LIQUIDADO
  CANCELADO
}

model TransacaoFinanceira {
  id             String             @id @default(uuid())
  descricao      String
  valor          Float
  tipo           TipoTransacao
  categoria      CategoriaTransacao
  status         StatusTransacao    @default(PENDENTE)
  dataVencimento DateTime
  dataPagamento  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  metadata       Json?

  // Relacionamentos opcionais
  imovelId   String?
  imovel     Imovel?                @relation(fields: [imovelId], references: [id], onDelete: SetNull)
  usuarioId  String?
  usuario    Users?                 @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  contratoId String?
  contrato   ContratoImovelLocacao? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  leaseId    String?
  lease      Lease?                 @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  // Vínculos
  comissao     Comissao[]
  conciliacoes MovimentacaoBancaria[]

  // Garante que cada cobrança de aluguel gere no máximo um repasse.
  transacaoOrigemId String?               @unique
  transacaoOrigem   TransacaoFinanceira?  @relation("RepasseOrigem", fields: [transacaoOrigemId], references: [id], onDelete: SetNull)
  repassesGerados   TransacaoFinanceira[] @relation("RepasseOrigem")

  // Integration Fields
  interNossoNumero       String?              @unique
  interPixCode           String? // PIX Copy & Paste string
  interBarcode           String? // Boleto Barcode
  interPdfKey            String? // File name/key in RustFS/MinIO
  interStatus            String? // Inter's status: APROVADO, PAGO, VENCIDO, etc.
  interCodigoSolicitacao String?              @unique
  interSeuNumero         String?              @unique
  interTxId              String?
  interOrigemRecebimento String?
  interDataRecebimento   DateTime?
  interValorRecebido     Decimal?             @db.Decimal(15, 2) // para confronto
  interMensagem          Json?
  itensCobranca          BoletoChargeItem[]
  descontosManutencao    DescontoManutencao[]

  @@index([leaseId])
  @@map("transacao_financeira")
}

model BoletoChargeItem {
  id          String              @id @default(uuid())
  transacaoId String
  transacao   TransacaoFinanceira @relation(fields: [transacaoId], references: [id], onDelete: Cascade)
  type        String
  description String
  amount      Decimal             @db.Decimal(15, 2)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([transacaoId, order])
  @@map("boleto_charge_item")
}

model InterWebhookEvent {
  id                 String                  @id @default(uuid())
  eventKey           String                  @unique
  codigoSolicitacao  String?
  nossoNumero        String?
  seuNumero          String?
  contaCorrente      String?
  situacao           String
  origemRecebimento  String?
  valorTotalRecebido Decimal?                @db.Decimal(15, 2)
  dataHoraSituacao   DateTime?
  payload            Json
  status             InterWebhookEventStatus
  tentativas         Int                     @default(0)
  erro               String?
  recebidoEm         DateTime                @default(now())
  processadoEm       DateTime?

  @@index([codigoSolicitacao])
  @@index([nossoNumero])
  @@index([status, recebidoEm])
  @@map("inter_webhook_event")
}

enum InterWebhookEventStatus {
  RECEBIDO
  PROCESSANDO
  PROCESSADO
  IGNORADO
  ERRO
}

model ConfiguracaoInter {
  id           String   @id @default(uuid())
  imobId       String   @unique
  imob         Imob     @relation(fields: [imobId], references: [id], onDelete: Cascade)
  clientId     String
  clientSecret String
  certPem      String   @db.Text
  keyPem       String   @db.Text
  sandbox      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("configuracao_inter")
}

enum TipoNegocioComissao {
  VENDA
  LOCACAO
}

enum StatusComissao {
  PENDENTE
  PAGO
}

model Comissao {
  id                String              @id @default(uuid())
  usuarioId         String
  usuario           Users               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  valorBrutoNegocio Float
  percentual        Float
  valorComissao     Float
  tipoNegocio       TipoNegocioComissao
  referenciaId      String? // ID do Imovel ou Contrato
  dataVencimento    DateTime
  status            StatusComissao      @default(PENDENTE)
  dataPagamento     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  transacaoId String?
  transacao   TransacaoFinanceira? @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  @@map("comissao")
}

enum StatusMovimentacaoBancaria {
  PENDENTE
  CONCILIADO
}

enum TipoMovimentacaoBancaria {
  CREDITO
  DEBITO
}

model MovimentacaoBancaria {
  id        String                     @id @default(uuid())
  data      DateTime
  descricao String
  valor     Float
  tipo      TipoMovimentacaoBancaria
  fitid     String?                    @unique // Identificador único da transação bancária (evitar duplicados)
  status    StatusMovimentacaoBancaria @default(PENDENTE)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  transacaoId String?
  transacao   TransacaoFinanceira? @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  @@map("movimentacao_bancaria")
}

//*************************************************************
// --------------- CONFIGURAÇÃO DO SITE PÚBLICO ---------------
//*************************************************************

model SiteConfig {
  id         String   @id @default("default")
  services   Json?
  mediaItems Json?
  reviews    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("site_config")
}
